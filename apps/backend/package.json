{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "prisma db push && node run_full_seed.js && node dist/create_sanjai_user.js && node dist/reset_admin.js && node dist/index.js",
    "start:pm2": "pm2 start dist/index.js --name marcos-backend --attach",
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "reset:admin": "ts-node src/reset_admin.ts",
    "seed:clothing-categories": "node dist/seedClothingCategories.js",
    "seed:demo-showcase": "node dist/seedDemoShowcase.js",
    "flush:cache": "node flush_cache.js",
    "db:indexes": "node create_indexes.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@types/compression": "^1.8.1",
    "argon2": "^0.40.1",
    "bullmq": "^5.1.9",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.15.0",
    "prisma": "^5.22.0",
    "redis": "^4.6.13",
    "socket.io": "^4.7.4",
    "twilio": "^6.0.2",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "ioredis-mock": "^8.9.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.4",
    "@types/uuid": "^9.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  }
}
